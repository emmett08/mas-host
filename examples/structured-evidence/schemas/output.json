{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operationId",
    "invocation_id",
    "target",
    "source",
    "freshness",
    "assessment",
    "coverage",
    "facts"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "structured-deployment-observation/1"
      ]
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_uid",
        "namespace_uid",
        "namespace",
        "kind",
        "name",
        "uid",
        "resource_version"
      ],
      "properties": {
        "cluster_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "namespace_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "kind": {
          "type": "string",
          "enum": [
            "Deployment"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "synthetic-fixture/1"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "NOT_RUN"
      ]
    },
    "assessment": {
      "type": "string",
      "enum": [
        "NOT_RUN"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "omissions"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "one-deployment-point"
          ]
        },
        "omissions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "pods",
              "images",
              "events",
              "logs",
              "live-freshness"
            ]
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "observed_generation",
        "desired_replicas",
        "replicas",
        "updated_replicas",
        "ready_replicas",
        "available_replicas",
        "unavailable_replicas"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "observed_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "desired_replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "updated_replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ready_replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "available_replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "unavailable_replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
